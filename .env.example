# This deployment's own origin, used for the server-side origin check.
# No trailing slash. For example: https://tms-fos-quick-form.vercel.app
APP_ORIGIN=

# Staff link builder. Use a long random value (32+ bytes) and share only with
# authorised TMS staff. Until this is set, /admin refuses every request and no
# client link can be created.
ADMIN_ACCESS_KEY=

# 32-byte base64 key used to encrypt stateless client prefill tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PREFILL_ENCRYPTION_KEY=
PREFILL_TTL_HOURS=72

# HMAC key used for hashed reference rate-limit keys and CSRF signing.
# Generate separately from PREFILL_ENCRYPTION_KEY.
SECURITY_HMAC_KEY=

# Email transport. Keep 'fake' until approved for live email.
# Subject is fixed in code as "FOS Questionnaire Answers" and is not configurable.
MAIL_MODE=fake
MAIL_TO=info@moneysolicitor.com
GMAIL_SENDER=info@moneysolicitor.com

# Gmail API OAuth credentials for THIS app only.
# Scope required: https://www.googleapis.com/auth/gmail.send (send only - no mailbox read).
# Must belong to the GMAIL_SENDER account. Never reuse credentials from another
# TMS project and never commit real values.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
